<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\schema.sql" />
    <Compile Remove="tests\**\*.vb" />
    <Compile Remove="tools\**\*.vb" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Form1.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Form1.Designer.vb"><DependentUpon>Form1.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Form1.resx"><DependentUpon>Form1.vb</DependentUpon></EmbeddedResource>
    <Compile Update="UI\Views\SignInView.vb"><SubType>UserControl</SubType></Compile>
    <Compile Update="UI\Views\SignInView.Designer.vb"><DependentUpon>SignInView.vb</DependentUpon></Compile>
    <EmbeddedResource Update="UI\Views\SignInView.resx"><DependentUpon>SignInView.vb</DependentUpon></EmbeddedResource>
    <Compile Update="UI\Views\RegistrationView.vb"><SubType>UserControl</SubType></Compile>
    <Compile Update="UI\Views\RegistrationView.Designer.vb"><DependentUpon>RegistrationView.vb</DependentUpon></Compile>
    <EmbeddedResource Update="UI\Views\RegistrationView.resx"><DependentUpon>RegistrationView.vb</DependentUpon></EmbeddedResource>
    <Compile Update="UI\Views\AccountsView.vb"><SubType>UserControl</SubType></Compile>
    <Compile Update="UI\Views\AccountsView.Designer.vb"><DependentUpon>AccountsView.vb</DependentUpon></Compile>
    <EmbeddedResource Update="UI\Views\AccountsView.resx"><DependentUpon>AccountsView.vb</DependentUpon></EmbeddedResource>
    <Compile Update="UI\Views\TransferView.vb"><SubType>UserControl</SubType></Compile>
    <Compile Update="UI\Views\TransferView.Designer.vb"><DependentUpon>TransferView.vb</DependentUpon></Compile>
    <EmbeddedResource Update="UI\Views\TransferView.resx"><DependentUpon>TransferView.vb</DependentUpon></EmbeddedResource>
    <Compile Update="UI\Views\ActivityView.vb"><SubType>UserControl</SubType></Compile>
    <Compile Update="UI\Views\ActivityView.Designer.vb"><DependentUpon>ActivityView.vb</DependentUpon></Compile>
    <EmbeddedResource Update="UI\Views\ActivityView.resx"><DependentUpon>ActivityView.vb</DependentUpon></EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
  </ItemGroup>

</Project>
